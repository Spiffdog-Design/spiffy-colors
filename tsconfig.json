{
  "compilerOptions": {
    "outDir": "./dist",
    "declarationDir": "types",
    "module": "esnext",
    "target": "ES2019",
    "lib": [
      "esnext"
    ],
    "jsx": "react-jsx",
    "declaration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "isolatedModules": true
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "dist/**.*"
  ]
}